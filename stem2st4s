#!/usr/bin/env python3
import os
import re
import json
import shutil
import subprocess
import uuid
import zipfile
from datetime import datetime, timezone
from pathlib import Path

# --- Configuration Directories ---
SCRIPT_DIR = Path(__file__).resolve().parent
CONFIG_FILE = SCRIPT_DIR / Path("config.json")
DEFAULT_CONFIG = {
    "mp3_dir": "~/mp3s",
    "zip_dir": "~/stemdeck",
    "pdf_dir": "~/pdfs",
    "output_dir": "~/stagetraxx",
    "work_dir": "~/temp"
}
if CONFIG_FILE.exists():
    try:
        with open(CONFIG_FILE, "r") as f:
            user_config = json.load(f)
            # Merge with defaults in case keys are missing
            config = {**DEFAULT_CONFIG, **user_config}
    except Exception as e:
        print(f"[!] Error reading config.json: {e}. Using defaults.")
        config = DEFAULT_CONFIG
else:
    print("[!] config.json not found. Using default paths.")
    config = DEFAULT_CONFIG

# --- Configuration Directories ---
MP3_DIR = Path(config["mp3_dir"])
ZIP_DIR = Path(config["zip_dir"])
PDF_DIR = Path(config["pdf_dir"])
OUTPUT_DIR = Path(config["output_dir"])
WORK_DIR = Path(config["work_dir"])


# --- Stage Traxx 4 Mappings ---
TRACK_COLORS = [
    1103805914635, 1103792268267, 1103790913921, 
    1103790257876, 1103799559096, 1103805498436, 1103805498436
]

TRACK2BUS = {
    "lead-vocals": 1,
    "backing-vocals": 2,
    "guitar": 3,
    "bass": 4,
    "drums": 5,
    "piano": 6,
    "other": 7
}

BUS2TRACK = {v: k for k, v in TRACK2BUS.items()}

STEM_NAMES = {
    "lead-vocals": "vox",
    "backing-vocals": "bgvox",
    "guitar": "guitar",
    "bass": "bass",
    "drums": "drums",
    "piano": "piano",
    "other": "others"
}

def sanitize_name(name: str) -> str:
    """Normalize song title for regex and zipfile matching."""
    return re.sub(r'[^a-zA-Z0-9]', '', name).lower()

def find_matching_zip(target_stem: str, search_dir: Path) -> Path | None:
    """Finds the Stemdeck zip file using flexible substring matching."""
    target_clean = sanitize_name(target_stem)
    for file_path in search_dir.glob("*.zip"):
        if sanitize_name(file_path.stem) in target_clean or target_clean in sanitize_name(file_path.stem):
            return file_path
    return None

def get_url_uuid(identifier: str) -> str:
    """Python equivalent of uuidgen -n @url --sha1"""
    return str(uuid.uuid5(uuid.NAMESPACE_URL, identifier))

def get_song_len(file_path: Path) -> float:
    """Extracts duration in seconds using ffprobe."""
    if not file_path.exists():
        return 0.0
    cmd = [
        "ffprobe", "-v", "error", 
        "-show_entries", "format=duration", 
        "-of", "default=noprint_wrappers=1:nokey=1", 
        str(file_path)
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return float(result.stdout.strip())
    except (subprocess.SubprocessError, ValueError):
        return 0.0

def classify_stem_type(filename: str) -> str:
    """Classify based strictly on the exact trailing suffix of the filename."""
    stem_lower = Path(filename).stem.lower()
    
    if stem_lower.endswith(('_lead_vocals', 'leadvocals', '_lead_vocal', 'lead_vocals')):
        return 'lead-vocals'
    elif stem_lower.endswith(('_backing_vocals', 'backingvocals', '_backing_vocal', '_bg_vocals', 'bg_vocals', 'backing_vocals')):
        return 'backing-vocals'
    elif stem_lower.endswith(('_drum', '_drums', 'drums', 'drum')):
        return 'drums'
    elif stem_lower.endswith(('_bass', 'bass')):
        return 'bass'
    elif stem_lower.endswith(('_guitar', 'guitar', '_guit', 'guit')):
        return 'guitar'
    elif stem_lower.endswith(('_piano', 'piano', '_keys', 'keys', 'synth')):
        return 'piano'
    else:
        return 'other'

def process_song(mp3_path: Path):
    song_stem = mp3_path.stem
    
    st4s_path = OUTPUT_DIR / f"{song_stem}.st4s"
    if st4s_path.exists():
        # print(f"[i] Skipping existing: {song_stem}")
        return

    print(f"[-] Processing: {song_stem}")

    # Match Stemdeck zip using fuzzy lookup
    zip_path = find_matching_zip(song_stem, ZIP_DIR)
    if not zip_path:
        print(f"[!] Warning: No matching Stemdeck zip found for {song_stem}")
        return

    # Generate Song UUID and extract first 8 digits for suffix
    song_uuid = get_url_uuid(song_stem)
    uuid_suffix = song_uuid.split('-')[0]
    
    # Setup temporary staging workspace using SONGFILE_SUFFIX folder pattern
    stem_folder_name = f"{song_stem}_{uuid_suffix}"
    song_work = WORK_DIR / song_stem
    stem_work_dir = song_work / stem_folder_name
    
    if song_work.exists():
        shutil.rmtree(song_work)
    stem_work_dir.mkdir(parents=True, exist_ok=True)
    
    extract_dir = song_work / "extracted"
    extract_dir.mkdir(parents=True, exist_ok=True)

    # Handle PDF chart import with try/except error handling
    has_pdf = False
    pdf_dest_filename = f"{song_stem}.pdf"
    pdf_dest_path = stem_work_dir / pdf_dest_filename
    pdf_source_path = PDF_DIR / f"{song_stem}.pdf"
  
    try:
        if pdf_source_path.exists():
            shutil.copy(pdf_source_path, pdf_dest_path)
            has_pdf = True
    except Exception as e:
        print(f"[!] Warning: Missing PDF file for {song_stem}: {e}")

    # Extract Stemdeck archive (flat extraction)
    try:
        with zipfile.ZipFile(zip_path, 'r') as zf:
            for member in zf.namelist():
                filename = os.path.basename(member)
                if filename:
                    source = zf.open(member)
                    # print(f"[D] extracting {filename} for {song_stem}")
                    target_path = extract_dir / filename
                    with open(target_path, "wb") as target:
                        shutil.copyfileobj(source, target)
                    source.close()
    except Exception as e:
        print(f"[!] Error extracting zip for {song_stem}: {e}")
        return

    # Parse Artist and Title, replacing underscores with spaces for visual consistency
    formatted_stem = song_stem.replace('_', ' ')
    parts = formatted_stem.split("-", 1)
    artist = parts[0].strip() if len(parts) > 1 else "Unknown Artist"
    title = parts[1].strip() if len(parts) > 1 else formatted_stem
    #print(f"[D] artist is: {artist} --And title is: {title}")

    timestamp = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

    # Process, rename, and move individual stems into the UUID-suffixed subfolder
    extracted_audio = list(extract_dir.glob("*.*"))
    track_entries = []
    duration = 0.0
    processed_stems = []

    for file in extracted_audio:
        #print(f"[D] found {file} for processing")

        if file.suffix.lower() in ['.mp3', '.wav', '.m4a']:
            stem_type = classify_stem_type(file.name)

            # FIX: Use stem_type dynamically so each file gets its own unique name
            dest_filename = f"{song_stem}_{stem_type}.mp3"
            dest_path = stem_work_dir / dest_filename
            
            #print(f"[D] moving {file} to {dest_path}")
            
            shutil.move(file, dest_path)
            processed_stems.append((stem_type, dest_path))

            if stem_type == 'lead-vocals' or duration == 0.0:
                duration = get_song_len(dest_path)

    if duration == 0.0:
        duration = get_song_len(mp3_path)

    # Build Track metadata entries
    for stem_type, dest_path in processed_stems:
        track_id = get_url_uuid(dest_path.name)
        bus_num = TRACK2BUS.get(stem_type, 7)
        short_name = STEM_NAMES.get(stem_type, "others")

        #print(f"[D] adding track {track_id} for {dest_path.name}")
        
        track_entry = {
            "id": track_id,
            "songID": song_uuid,
            "name": short_name,
            "bus": bus_num - 1,
            "filePath": f"{stem_folder_name}/{dest_path.name}",
            "volume": 0.0,
            "mute": False,
            "pan": 0.0,
            "equalizer": {
                "bypass": False,
                "bands": [
                    {"bw": 1, "freq": 100, "gain": 0.0, "label": "LO", "type": 1},
                    {"bw": 1, "freq": 500, "gain": 0.0, "label": "LM", "type": 0},
                    {"bw": 2, "freq": 2000, "gain": 0.0, "label": "HM", "type": 0},
                    {"bw": 1, "freq": 10000, "gain": 0.0, "label": "HI", "type": 2}
                ]
            },
            "duration": duration,
            "hasMarkers": False,
            "lastModified": timestamp,
            "muteGroupMask": 0,
            "transpose": False
        }
        track_entries.append(track_entry)

    # Sort tracks by bus order (1 to 7) and assign sequential track numbers
    track_entries.sort(key=lambda x: x["bus"])
    for idx, track in enumerate(track_entries, start=1):
        track["number"] = idx
        track["color"] = TRACK_COLORS[(idx - 1) % len(TRACK_COLORS)]

    # Build master Stage Traxx 4 JSON payload (`share_data.json`)
    share_data = {
        "metadata": {
            "created": timestamp,
            "type": "full",
            "version": "4.1"
        },
        "folders": [],
        "keywords": [],
        "playlistKeywords": [],
        "playlists": [],
        "playlistSongs": [],
        "regions": [],
        "songKeywords": [],
        "songs": [
            {
                "id": song_uuid,
                "title": title,
                "artist": artist,
                "bpm": 120,
                "duration": duration,
                "added": timestamp,
                "lastModified": timestamp,
                "volume": 0.0,
                "pitch": 0,
                "speed": 1.0,
                "color": 0,
                "beatAnchorTime": 0.0,
                "capo": 0,
                "countInBeats": 4,
                "chordTranspose": 0,
                "endTime": duration,
                "fadeIn": 0.0,
                "fadeOut": 0.0,
                "fontSize": 22,
                "metronomeMode": 0,
                "metronomeType": 2,
                "pitchToChords": True,
                "playCount": 0,
                "scrollSpeed": 1.2,
                "startTime": 0.0,
                "timecodeOffset": 0.0,
                "tune": 0,
                "lyrics": "",
                "pdfPath": f"{stem_folder_name}/{pdf_dest_filename}" if has_pdf else ""
            }
        ],
        "tracks": track_entries
    }

    with open(song_work / "share_data.json", "w") as f:
        json.dump(share_data, f, indent=2)

    # Cleanup extraction folder
    if extract_dir.exists():
        shutil.rmtree(extract_dir)

    # Compress workspace directory structure into final .st4s package
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    
    with zipfile.ZipFile(st4s_path, 'w', zipfile.ZIP_DEFLATED) as zf:
        for file_path in song_work.rglob("*"):
            if file_path.is_file():
                arcname = file_path.relative_to(song_work)
                zf.write(file_path, arcname)

    shutil.rmtree(song_work)
    print(f"[+] Successfully built: {st4s_path.name}")

def main():
    WORK_DIR.mkdir(exist_ok=True)

    VALID_EXTENSIONS = {'.mp3', '.flac', '.mp4'}
    audio_files = [p for p in MP3_DIR.iterdir() if p.is_file() and p.suffix.lower() in VALID_EXTENSIONS]

    print(f"Found {len(audio_files)} tracks to process.")

    for afile in audio_files:
        process_song(afile)
        
    if WORK_DIR.exists():
        shutil.rmtree(WORK_DIR)
    print("[+] Batch processing complete.")

if __name__ == "__main__":
    main()
